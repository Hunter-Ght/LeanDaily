 "fw-plan-v1": "{\"version\":2,\"startDate\":\"2026-10-16\",\"schedule\":{\"1\":\"w1\",\"3\":\"w2\",\"5\":\"w3\"},\"order\":[\"w1\",\"w2\",\"w3\"],\"warmup\":{\"minutes\":5,\"items\":[\"肩关节活动\",\"轻微肩胛运动\",\"原地走动\",\"徒手深蹲\"],\"note\":\"第一个动作先做一组特别轻的练习\"},\"rules\":[\"每组留 2～3 次余力，不追求力竭\",\"组间休息 60～120 秒，俯卧撑或深蹲累得厉害就休息到 2 分钟\",\"尖锐疼痛、关节疼、明显头晕就停下；肌肉发酸和关节疼不是一回事\"],\"ladders\":{\"pushup\":{\"stage\":0,\"steps\":[{\"name\":\"高位俯卧撑\",\"min\":6,\"max\":12,\"hint\":\"双手撑稳固的厨房台面或高桌，连续两次做满 12 次、动作不变形就升级\"},{\"name\":\"低台面俯卧撑\",\"min\":6,\"max\":12,\"hint\":\"换成更低、仍然稳固的支撑物，连续两次做满 12 次就升级\"},{\"name\":\"跪姿俯卧撑\",\"min\":8,\"max\":12,\"hint\":\"肩—髋—膝成一条线，连续两次做满 12 次就试标准俯卧撑\"},{\"name\":\"标准俯卧撑\",\"min\":1,\"max\":8,\"hint\":\"每组 1～3 个标准动作起步，做不动就换回高位版补量\"}]}},\"workouts\":{\"w1\":{\"name\":\"胸 + 肩 + 腹\",\"tag\":\"胸肌重点日\",\"note\":\"只有 30 分钟：做高位俯卧撑 + 弹力带胸推 + 腹肌。胸肌是主角，不用全做到很累。\",\"exercises\":[{\"id\":\"e1\",\"ladder\":\"pushup\",\"name\":\"高位俯卧撑\",\"part\":\"胸\",\"sets\":2,\"min\":6,\"max\":12,\"unit\":\"reps\",\"side\":false,\"weight\":0,\"core\":true,\"optional\":false,\"gear\":\"稳固、不滑动的台面\",\"tip\":\"身体保持一条直线；动作标准比多做几个更有用。台面不能晃、不能打滑，不要用带轮子的椅子。\",\"alts\":[],\"machine\":false,\"rest\":0},{\"id\":\"e2\",\"name\":\"弹力带胸推\",\"part\":\"胸\",\"sets\":2,\"min\":10,\"max\":15,\"unit\":\"reps\",\"side\":false,\"weight\":0,\"core\":true,\"optional\":false,\"gear\":\"黑色无手柄弹力带\",\"alt\":\"哑铃地板卧推\",\"alts\":[{\"name\":\"哑铃地板卧推\",\"weight\":5}],\"tip\":\"弹力带从背后肩胛附近绕过，两手握住两端向前推。先检查有没有老化破损，别让它朝脸回弹；阻力不合适就改哑铃地板卧推。\",\"machine\":false,\"rest\":0},{\"id\":\"e3\",\"name\":\"哑铃肩推\",\"part\":\"肩\",\"sets\":2,\"min\":6,\"max\":10,\"unit\":\"reps\",\"side\":false,\"weight\":5,\"core\":false,\"optional\":true,\"gear\":\"5 kg 哑铃 × 2\",\"tip\":\"5 kg 太重、需要后仰借力，就改用水瓶，不硬上。\",\"alts\":[],\"machine\":false,\"rest\":0},{\"id\":\"e4\",\"name\":\"轻重量侧平举\",\"part\":\"肩\",\"sets\":2,\"min\":10,\"max\":15,\"unit\":\"reps\",\"side\":false,\"weight\":1,\"core\":false,\"optional\":false,\"gear\":\"500 mL～1.5 L 水瓶（重量按 1 kg 